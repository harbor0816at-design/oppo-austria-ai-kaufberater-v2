APP_ENV=development
ADMIN_API_KEY=change-me
DATABASE_URL=sqlite:////tmp/oppo_kaufberater.db
REDIS_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_REASONING_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com
BRAVE_SEARCH_API_KEY=
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Public endpoint protection
CHAT_RATE_LIMIT_PER_MINUTE=30
LEAD_RATE_LIMIT_PER_HOUR=10
ANALYTICS_RATE_LIMIT_PER_MINUTE=120

# Google Sheets Source_B (private sheet; service account has Viewer access)
SOURCE_B_PROVIDER=google_sheets
GOOGLE_SHEETS_SPREADSHEET_ID=1OWEWh1--R6txBCkVRlKXB5xGER4AGMXm2ldgHKGayYc
GOOGLE_SERVICE_ACCOUNT_JSON=
# Alternative for Vercel: base64 of the complete service-account JSON
GOOGLE_SERVICE_ACCOUNT_JSON_B64=
GOOGLE_SHEETS_PRODUCTS_RANGE=Products!A1:AG2000
GOOGLE_SHEETS_PROMOTIONS_RANGE=Promotions!A1:T1000
GOOGLE_SHEETS_SERVICES_RANGE=Services!A1:L500
GOOGLE_SHEETS_CACHE_TTL_SECONDS=300
GOOGLE_SHEETS_FAIL_OPEN=true

# Production readiness requirements:
# APP_ENV=production
# ADMIN_API_KEY must be a random value of at least 24 characters.
# DATABASE_URL must point to persistent PostgreSQL (not SQLite /tmp).
# REDIS_URL must point to a shared Redis instance for distributed rate limiting.
# DEEPSEEK_API_KEY and Google service-account credentials must be configured.
# GET /readyz returns HTTP 200 only when the critical production checks pass.
